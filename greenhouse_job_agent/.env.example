# Greenhouse Job Application Agent Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Greenhouse board token (e.g., "stripe", "airbnb", "notion")
# Find this in the company's careers page URL: boards.greenhouse.io/{board_token}
GH_BOARD_TOKEN=examplecompany

# OpenAI API key for resume tailoring and answer generation
OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# USER PROFILE (for applications)
# =============================================================================

# Your contact information
USER_FIRST_NAME=Alex
USER_LAST_NAME=Dev
USER_EMAIL=alex@example.com
USER_PHONE=+1-555-555-5555

# Your profile for answer generation (comma-separated)
USER_NAME=Alex Dev
USER_SKILLS=Python,LangChain,APIs,Kubernetes,Docker
USER_PROJECTS=Embeddings search,Workflow automation,API gateway

# =============================================================================
# RESUME
# =============================================================================

# Path to your resume file (supports .md, .txt, .html)
# If not set, the agent will search for:
#   ./resume.md, ./resume.txt, ./Resume.md, ~/resume.md
RESUME_FILE=resume.md

# Alternative: Set resume content directly (not recommended for long resumes)
# BASE_RESUME_MD=...

# =============================================================================
# JOB FILTERS
# =============================================================================

# Search query to match in job titles
JOB_QUERY=software

# Locations to filter by (comma-separated)
JOB_LOCATIONS=Remote,United States,San Francisco

# =============================================================================
# API SETTINGS
# =============================================================================

# Request timeout in seconds
REQUEST_TIMEOUT=20

# Maximum retry attempts for failed requests
MAX_RETRIES=3

# Exponential backoff factor for retries (sleep = factor^attempt)
RETRY_BACKOFF=2.0

# Rate limiting: max calls per window
RATE_LIMIT_CALLS=10

# Rate limiting: window size in seconds
RATE_LIMIT_WINDOW=60

# =============================================================================
# LLM SETTINGS
# =============================================================================

# OpenAI model to use
OPENAI_MODEL=gpt-4o-mini

# Temperature for LLM responses (0.0 = deterministic, 1.0 = creative)
OPENAI_TEMPERATURE=0.2

# =============================================================================
# STORAGE & POLLING
# =============================================================================

# Path to SQLite database for persistent state
STATE_DB_PATH=greenhouse_agent_state.db

# Polling interval in seconds (default: 15 minutes)
POLL_INTERVAL=900

# Run only once instead of continuous loop (for testing)
RUN_ONCE=false

# =============================================================================
# LOGGING
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional: Path to log file (logs to console if not set)
# LOG_FILE=greenhouse_agent.log
